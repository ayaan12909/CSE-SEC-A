
#include <stdio.h>
int main()
{
    int n = 5;
    int arr[6] = {1, 2, 3, 4, 5};
    int idx;
    printf("enter index :");
    scanf("%d", &idx);

    for (int i = n; i > idx; i--)
    {
        arr[i] = arr[i - 1];
    }
     
    printf("enter no :");
    scanf("%d",&arr[idx]);
    n++;
    for (int i = 0; i < n; i++)
    {
        printf("%d", arr[i]);
    }

    return 0;
}
